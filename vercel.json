{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/inicio",
      "destination": "/index.html"
    },
    {
      "source": "/noticias",
      "destination": "/Noticias.dc.html"
    },
    {
      "source": "/convocatorias",
      "destination": "/Convocatorias.dc.html"
    },
    {
      "source": "/proyectos",
      "destination": "/Proyectos.dc.html"
    },
    {
      "source": "/documentos",
      "destination": "/Documentos.dc.html"
    },
    {
      "source": "/nosotros",
      "destination": "/Nosotros.dc.html"
    },
    {
      "source": "/contacto",
      "destination": "/Contacto.dc.html"
    },
    {
      "source": "/buzon",
      "destination": "/Buzon.dc.html"
    },
    {
      "source": "/privacidad",
      "destination": "/Privacidad.dc.html"
    },
    {
      "source": "/terminos",
      "destination": "/Terminos.dc.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}